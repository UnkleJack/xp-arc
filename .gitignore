# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# Runtime artifacts (preserved on disk, ignored from git)
asset-engine/browser-profiles/
asset-engine/generation-runs/
asset-engine/logs/
asset-engine/review-vault/approved/*
asset-engine/review-vault/pending/*
asset-engine/review-vault/rejected/*
asset-engine/review-vault/templates/*
!asset-engine/review-vault/**/.gitkeep

# Competitive intel runtime data
data/competitive/
reports/competitive/
sql/*.db

# OS / Editor
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
batch_log.txt
proof_of_work_log.jsonl

# Test artifacts
*.db-journal
test_*.db
xp_arc_*.db
stress_test.db

# SQLite databases — pool state and gauntlet phase DBs are generated at
# runtime. `*.db` is deliberately broad: 32 database files totalling ~24 MB
# were committed by `chore: add gauntlet test artifacts` and .gitignore could
# not reclaim them, because ignore rules never apply to already-tracked files.
# CI uploads these as workflow artifacts when a run fails; they do not belong
# in the repository.
*.db
*.db-wal
*.db-shm

# Gauntlet run reports — one JSON per run, written into the repo root.
gauntlet_report_*.json

# DRAGON materialized state. Regenerated by batch_run.py; the static dashboard
# fetches dragon/pool_state.json and run_persistent.py serves it live at
# /pool_state.json. A committed snapshot is 32 MB of stale data that renders
# indistinguishably from current data, which is worse than the load error a
# fresh clone now shows until the pipeline has been run.
dragon/pool_state.json

# Per-run DRAGON exports written next to whatever --db was passed.
*_dragon.json

# Station HMAC keys. NEVER tracked — these are live write-auth credentials.
# Keys are generated per Pool database at runtime (see IntelligencePool._key_file)
# and encrypted at rest with XP_ARC_MASTER_KEY.
#
# The previous form of this block was `station_keys.json` plus
# `*.station_keys.json.enc`, and it leaked. A pattern with no slash matches only
# that exact filename, so it never covered the per-database sidecars that
# `_key_file` writes next to each Pool -- `<db>.station_keys.json` -- and 16 of
# those were tracked and publicly fetchable, 14 of them holding an `aboyeur`
# signing key. The wildcards below match every spelling the code can produce.
*.station_keys.json
station_keys.json
*.station_keys.json.enc
station_keys.json.enc
*.enc
*.key
*.pem

# Append-only run logs. `proof_of_work_log.jsonl` was listed by exact name and
# tracked anyway; the extension pattern covers whatever the next writer calls it.
*.jsonl
